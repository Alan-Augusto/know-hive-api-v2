// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                 @id @default(uuid())
  email               String                 @unique
  password            String
  name                String?
  profile_picture     String?                @default("https://img.freepik.com/premium-psd/contact-icon-illustration-isolated_23-2151903357.jpg?semt=ais_hybrid&w=740")
  collections_created Collection[]
  questions_created   Question[]
  collections_access  CollectionUserAccess[]
  questions_access    QuestionUserAccess[] // Nova relação
  collection_likes    CollectionLike[] // Nova relação para likes de coleções
  question_likes      QuestionLike[] // Nova relação para likes de questões
  question_responses  QuestionResponse[] // Nova relação para respostas às questões
}

model Collection {
  id          String                 @id @default(uuid())
  title       String
  description String
  is_public   Boolean                @default(false)
  created_at  DateTime               @default(now())
  updated_at  DateTime               @updatedAt
  author_id   String
  author      User                   @relation(fields: [author_id], references: [id])
  questions   QuestionCollection[]
  permissions CollectionUserAccess[]
  likes       CollectionLike[] // Nova relação para likes
  tags        CollectionTag[] // Nova relação para tags
  responses   QuestionResponse[] // Nova relação para respostas no contexto da coleção
}

model Question {
  id           String               @id @default(uuid())
  title        String               @default("Título")
  image_url    String?
  statement    String
  is_public    Boolean              @default(false)
  type_id      Int
  type         QuestionType         @relation(fields: [type_id], references: [id])
  created_at   DateTime             @default(now())
  updated_at   DateTime             @updatedAt
  collections  QuestionCollection[]
  alternatives Alternative[]
  author_id    String
  author       User                 @relation(fields: [author_id], references: [id])
  permissions  QuestionUserAccess[] // Nova relação
  likes        QuestionLike[] // Nova relação para likes
  tags         QuestionTag[] // Nova relação para tags
  responses    QuestionResponse[] // Nova relação para respostas
}

model QuestionType {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  questions   Question[]
}

model Alternative {
  id          String   @id @default(uuid())
  text        String // Texto da alternativa
  is_correct  Boolean  @default(false) // Indica se esta é a alternativa correta
  question_id String
  question    Question @relation(fields: [question_id], references: [id], onDelete: Cascade)

  // Nova relação: uma alternativa pode estar em múltiplas respostas
  selected_in ResponseAlternative[]

  created_at DateTime @default(now()) // Opcional: se quiser saber quando a alternativa foi criada
  updated_at DateTime @updatedAt // Opcional: se quiser saber quando foi atualizada

  @@index([question_id]) // Index para otimizar a busca de alternativas por questão
}

model QuestionCollection {
  question_id   String
  collection_id String
  question      Question   @relation(fields: [question_id], references: [id], onDelete: Cascade) // Adicionei onDelete: Cascade
  collection    Collection @relation(fields: [collection_id], references: [id], onDelete: Cascade) // Adicionei onDelete: Cascade
  assigned_at   DateTime   @default(now())

  @@id([question_id, collection_id])
}

model CollectionPermissionType {
  id          Int                    @id @default(autoincrement())
  name        String                 @unique
  description String?
  collections CollectionUserAccess[]
  questions   QuestionUserAccess[] // Nova relação - reutilizando os mesmos tipos de permissão
}

model CollectionUserAccess {
  id                 String                   @id @default(uuid())
  user_id            String
  collection_id      String
  permission_type_id Int
  user               User                     @relation(fields: [user_id], references: [id])
  collection         Collection               @relation(fields: [collection_id], references: [id])
  permission_type    CollectionPermissionType @relation(fields: [permission_type_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, collection_id]) // Garante que um usuário só pode ter uma permissão por coleção
  @@index([collection_id]) // Index para otimizar a busca de permissões por coleção
}

model QuestionUserAccess {
  id                 String                   @id @default(uuid())
  user_id            String
  question_id        String
  permission_type_id Int
  user               User                     @relation(fields: [user_id], references: [id])
  question           Question                 @relation(fields: [question_id], references: [id], onDelete: Cascade)
  permission_type    CollectionPermissionType @relation(fields: [permission_type_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, question_id]) // Garante que um usuário só pode ter uma permissão por questão
  @@index([question_id]) // Index para otimizar a busca de permissões por questão
}

model CollectionLike {
  id            String     @id @default(uuid())
  user_id       String
  collection_id String
  user          User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  collection    Collection @relation(fields: [collection_id], references: [id], onDelete: Cascade)
  created_at    DateTime   @default(now())

  @@unique([user_id, collection_id]) // Garante que um usuário só pode dar um like por coleção
  @@index([collection_id]) // Index para otimizar a busca de likes por coleção
}

model QuestionLike {
  id          String   @id @default(uuid())
  user_id     String
  question_id String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  question    Question @relation(fields: [question_id], references: [id], onDelete: Cascade)
  created_at  DateTime @default(now())

  @@unique([user_id, question_id]) // Garante que um usuário só pode dar um like por questão
  @@index([question_id]) // Index para otimizar a busca de likes por questão
}

model Tag {
  id          String          @id @default(uuid())
  name        String          @unique
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt
  collections CollectionTag[]
  questions   QuestionTag[]
}

model CollectionTag {
  id            String     @id @default(uuid())
  collection_id String
  tag_id        String
  collection    Collection @relation(fields: [collection_id], references: [id], onDelete: Cascade)
  tag           Tag        @relation(fields: [tag_id], references: [id], onDelete: Cascade)
  assigned_at   DateTime   @default(now())

  @@unique([collection_id, tag_id]) // Garante que uma tag não pode ser atribuída duas vezes à mesma coleção
  @@index([collection_id]) // Index para otimizar a busca de tags por coleção
  @@index([tag_id]) // Index para otimizar a busca de coleções por tag
}

model QuestionTag {
  id          String   @id @default(uuid())
  question_id String
  tag_id      String
  question    Question @relation(fields: [question_id], references: [id], onDelete: Cascade)
  tag         Tag      @relation(fields: [tag_id], references: [id], onDelete: Cascade)
  assigned_at DateTime @default(now())

  @@unique([question_id, tag_id]) // Garante que uma tag não pode ser atribuída duas vezes à mesma questão
  @@index([question_id]) // Index para otimizar a busca de tags por questão
  @@index([tag_id]) // Index para otimizar a busca de questões por tag
}

model QuestionResponse {
  id             String   @id @default(uuid())
  user_id        String
  question_id    String
  collection_id  String? // Opcional: Se a resposta foi dada no contexto de uma coleção
  response_time  Int? // Tempo em segundos para responder (opcional)
  answered_at    DateTime @default(now())
  attempt_number Int      @default(1) // Número da tentativa (1, 2, 3...)
  is_final       Boolean  @default(false) // Indica se esta é a resposta final do usuário

  // Relações
  user       User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [question_id], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collection_id], references: [id], onDelete: Cascade)

  // Nova relação: uma resposta pode ter múltiplas alternativas selecionadas
  selected_alternatives ResponseAlternative[]

  // Índices para otimização
  @@index([user_id]) // Para buscar respostas de um usuário
  @@index([question_id]) // Para buscar respostas de uma questão
  @@index([collection_id]) // Para buscar respostas de uma coleção
  @@index([user_id, collection_id]) // Para buscar progresso do usuário em uma coleção
  @@index([answered_at]) // Para ordenação temporal
  @@index([user_id, question_id, attempt_number]) // Para buscar tentativas específicas
  @@index([user_id, question_id, is_final]) // Para buscar a resposta final
}

// Nova tabela intermediária para relacionar respostas com alternativas
model ResponseAlternative {
  id             String @id @default(uuid())
  response_id    String
  alternative_id String

  // Relações
  response    QuestionResponse @relation(fields: [response_id], references: [id], onDelete: Cascade)
  alternative Alternative      @relation(fields: [alternative_id], references: [id], onDelete: Cascade)

  @@unique([response_id, alternative_id]) // Evita duplicatas
  @@index([response_id]) // Para buscar alternativas de uma resposta
  @@index([alternative_id]) // Para buscar respostas de uma alternativa
}
